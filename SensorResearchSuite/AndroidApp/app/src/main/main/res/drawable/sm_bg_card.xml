<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: rounded with a hairline border so cards separate from the near-black screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sm_surface_card" />
    <stroke android:width="1dp" android:color="@color/sm_border_subtle" />
    <corners android:radius="@dimen/sm_radius_card" />
</shape>
