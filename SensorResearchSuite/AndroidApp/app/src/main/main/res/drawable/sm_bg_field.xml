<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: recessed well, 3:1 outline, thick cyan outline while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_well" />
            <stroke android:width="2dp" android:color="@color/sm_border_focus" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_well" />
            <stroke android:width="1dp" android:color="@color/sm_border_subtle" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_well" />
            <stroke android:width="1dp" android:color="@color/sm_border_field" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
</selector>
