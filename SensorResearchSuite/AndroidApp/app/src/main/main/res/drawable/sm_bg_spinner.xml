<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner: same field shape plus a chevron, so it reads as a dropdown (a flat background hides the default arrow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_well" />
            <stroke android:width="1dp" android:color="@color/sm_border_field" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:end="12dp"
        android:drawable="@drawable/sm_ic_chevron_down"
        android:gravity="end|center_vertical" />
</layer-list>
