<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsible-section header: raised row with ripple, so it reads as tappable. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sm_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sm_surface_raised" />
            <stroke android:width="1dp" android:color="@color/sm_border_subtle" />
            <corners android:radius="@dimen/sm_radius_inner" />
        </shape>
    </item>
</ripple>
