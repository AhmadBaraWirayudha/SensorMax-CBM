<?xml version="1.0" encoding="utf-8"?>
<!--
SensorMax main screen.

Structure
  - Action dock pinned to the bottom (always thumb-reachable).
  - Scrolling body above the dock: one include per card, top to bottom.
  - Every view id from the previous layout is preserved (the Kotlin code binds by id).
Look and feel: res/values/colors.xml (tokens), sensormax_styles.xml (widget styles), sensormax_dimens.xml (sizes).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sm_surface_screen"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Action dock: secondary actions on top, primary recording actions on the bottom row -->
    <LinearLayout
        android:id="@+id/llThumbActionDock"
        style="@style/SensorMax.Dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSnapshot"
                style="@style/SensorMax.Button.Accent.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/sm_action_height_secondary"
                android:layout_weight="1.3"
                android:layout_marginEnd="8dp"
                android:text="@string/action_snapshot" />
            <Button
                android:id="@+id/btnImportExperimentProfile"
                style="@style/SensorMax.Button.Outlined.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/sm_action_height_secondary"
                android:layout_weight="1"
                android:text="@string/action_import_profile" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnStreamAndLog"
                style="@style/SensorMax.Button.Record"
                android:layout_width="0dp"
                android:layout_height="@dimen/sm_action_height"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/action_stream_log" />
            <Button
                android:id="@+id/btnOfflineLog"
                style="@style/SensorMax.Button.Neutral"
                android:layout_width="0dp"
                android:layout_height="@dimen/sm_action_height"
                android:layout_weight="1"
                android:text="@string/action_offline_log" />
        </LinearLayout>
    </LinearLayout>

    <!-- Persistent preference bar: language stays visible while diagnostic cards scroll. -->
    <LinearLayout
        android:id="@+id/llLanguageTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/sm_surface_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/sm_screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/sm_screen_padding"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvLanguageSelectorHeading"
                    style="@style/SensorMax.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/spinnerLanguagePreference"
                    android:maxLines="2"
                    android:text="@string/language_selector_heading" />
                <TextView
                    style="@style/SensorMax.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/language_selector_hint" />
            </LinearLayout>
            <Spinner
                android:id="@+id/spinnerLanguagePreference"
                style="@style/SensorMax.Spinner"
                android:layout_width="152dp"
                android:layout_height="@dimen/sm_control_height"
                android:contentDescription="@string/language_selector_content_description"
                android:entries="@array/language_options"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/SensorMax.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/spinnerMeasurementSystem"
                android:maxLines="2"
                android:text="@string/preferences_units_label" />
            <Spinner
                android:id="@+id/spinnerMeasurementSystem"
                style="@style/SensorMax.Spinner"
                android:layout_width="152dp"
                android:layout_height="@dimen/sm_control_height"
                android:contentDescription="@string/preferences_units_label" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrolling body -->
    <ScrollView
        android:id="@+id/scrollDiagnosticBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llLanguageTopBar"
        android:layout_above="@id/llThumbActionDock"
        android:background="@color/sm_surface_screen"
        android:clipToPadding="false"
        android:fadingEdge="vertical"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:padding="@dimen/sm_screen_padding"
        android:requiresFadingEdge="vertical"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/section_field_header" />
            <include layout="@layout/section_condition_summary" />
            <include layout="@layout/section_live_waveform" />
            <include layout="@layout/section_spectrum" />
            <include layout="@layout/section_fault_screening" />
            <include layout="@layout/section_trend_history" />
            <include layout="@layout/section_secondary_telemetry" />
            <include layout="@layout/section_asset_point" />
            <include layout="@layout/section_reference_limits" />
            <include layout="@layout/section_mounting_axis" />
            <include layout="@layout/section_sensor_characterization" />
            <include layout="@layout/section_acquisition" />
            <include layout="@layout/section_device_debug" />

            <TextView
                style="@style/SensorMax.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="@string/footer_tagline" />
            <TextView
                style="@style/SensorMax.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="@string/footer_note" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
