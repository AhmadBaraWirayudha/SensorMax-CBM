<?xml version="1.0" encoding="utf-8"?>
<!--
Header card: product identity and the live status line (tvStatus is updated from code).
Styles: res/values/sensormax_styles.xml - colours: res/values/colors.xml - strings: res/values/strings.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SensorMax.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/SensorMax.Text.AppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_title" />
            <TextView
                style="@style/SensorMax.Text.AppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/header_subtitle" />
        </LinearLayout>
        <TextView
            style="@style/SensorMax.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_badge_field" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvStatus"
        style="@style/SensorMax.Text.Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_initial" />
</LinearLayout>
