    <!-- =====================================================================
         SensorMax UI tokens - used by layouts, styles and drawables.
         Change the look of the app HERE; layouts never hard-code hex values.
         ===================================================================== -->

    <!-- Surfaces: screen < card < raised. Wells (charts, inputs, log) are recessed. -->
    <color name="sm_surface_screen">#070B12</color>
    <color name="sm_surface_card">#0E1623</color>
    <color name="sm_surface_raised">#162135</color>
    <color name="sm_surface_well">#080D16</color>
    <color name="sm_surface_log">#05080E</color>
    <color name="sm_surface_banner">#1B2636</color>
    <color name="sm_surface_ok_chip">#123329</color>
    <color name="sm_surface_segment_on">#1D3350</color>

    <!-- Borders: hairline for cards, 3:1 outline for controls, cyan when focused -->
    <color name="sm_border_subtle">#1F2D44</color>
    <color name="sm_border_field">@color/sm_gray</color>
    <color name="sm_border_focus">@color/sm_cyan</color>

    <!-- Text: every pair below is at least 4.5:1 on the surfaces above -->
    <color name="sm_text_primary">#F8FAFC</color>
    <color name="sm_text_body">@color/sm_text_light</color>
    <color name="sm_text_label">#AAB7CB</color>
