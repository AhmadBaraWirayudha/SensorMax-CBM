    <color name="sm_text_on_action">#FFFFFF</color>
    <color name="sm_text_bad">#FCA5A5</color>
    <color name="sm_text_disabled">#7C8AA0</color>

    <!-- Severity banner fills (set from code): white text is at least 5:1 on each -->
    <color name="sm_banner_alert">#B91C1C</color>
    <color name="sm_banner_warn">#B45309</color>
    <color name="sm_banner_ok">#15803D</color>

