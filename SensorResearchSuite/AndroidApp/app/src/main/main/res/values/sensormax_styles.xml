<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================================
         SensorMax widget styles.
         LOOK lives here (colour, type, shape, padding). STRUCTURE stays in the
         layouts (ids, sizes, weights, margins, text, input types).
         Every style has an explicit parent (empty = none) so nothing is inherited by accident.
         ===================================================================== -->

    <!-- ===== Containers ===== -->

    <!-- Card: one logical group of controls -->
    <style name="SensorMax.Card" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/sm_bg_card</item>
        <item name="android:padding">@dimen/sm_card_padding</item>
        <item name="android:layout_marginBottom">@dimen/sm_card_gap</item>
    </style>

    <!-- Foldable card: padding moves to the header and body so the whole header row is tappable.
         clipToOutline keeps the header ripple inside the rounded corners. -->
    <style name="SensorMax.Card.Collapsible" parent="SensorMax.Card">
        <item name="android:padding">0dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="SensorMax.CardHeader" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/sm_bg_header</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">@dimen/sm_control_height</item>
        <item name="android:paddingStart">@dimen/sm_card_padding</item>
        <item name="android:paddingEnd">@dimen/sm_card_padding</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SensorMax.CardBody" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/sm_card_padding</item>
        <item name="android:paddingEnd">@dimen/sm_card_padding</item>
        <item name="android:paddingBottom">@dimen/sm_card_padding</item>
    </style>

    <!-- Fold arrow: points up while the card is open (code rotates it to 0 when folded) -->
    <style name="SensorMax.Chevron" parent="">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:rotation">180</item>
        <item name="android:src">@drawable/sm_ic_chevron_down</item>
    </style>

    <!-- Raised inset inside a card (metric tile, sensor list) -->
    <style name="SensorMax.Tile" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/sm_bg_raised</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Action dock pinned to the bottom of the screen -->
    <style name="SensorMax.Dock" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/sm_bg_dock</item>
        <item name="android:elevation">20dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Axis segmented control (RadioGroup) and its segments (RadioButton) -->
    <style name="SensorMax.Segmented" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/sm_bg_segmented</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="SensorMax.Segment" parent="">
        <!-- Both attributes: AppCompat 1.4+ reads buttonCompat before android:button -->
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/sm_bg_segment</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/sm_action_height_secondary</item>
        <item name="android:textColor">@color/sm_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chart / waterfall surface; clipToOutline keeps the rounded corners when the view draws edge to edge -->
    <style name="SensorMax.Chart" parent="">
        <item name="android:background">@drawable/sm_bg_well</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <!-- ===== Text ===== -->
    <!-- Type scale: 24 RMS / 22 app title / 18 card title / 16 values + inputs / 14 labels + buttons / 13 captions / 12 log -->

    <style name="SensorMax.Text.AppTitle" parent="">
        <item name="android:textColor">@color/sm_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="SensorMax.Text.AppSubtitle" parent="">
        <item name="android:textColor">@color/sm_text_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SensorMax.Text.CardTitle" parent="">
        <item name="android:textColor">@color/sm_text_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Descriptions, notes, disclaimers -->
    <style name="SensorMax.Text.Caption" parent="">
        <item name="android:textColor">@color/sm_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Label above a field or a chart -->
    <style name="SensorMax.Text.Label" parent="">
        <item name="android:textColor">@color/sm_text_label</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Numeric read-outs: monospace so digits do not jitter -->
    <style name="SensorMax.Text.Value" parent="">
        <item name="android:textColor">@color/sm_text_body</item>
        <item name="android:textSize">16sp</item>
        <item name="android:typeface">monospace</item>
    </style>

    <style name="SensorMax.Text.Metric" parent="SensorMax.Text.Value">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SensorMax.Text.Hero" parent="SensorMax.Text.Value">
        <item name="android:textColor">@color/sm_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SensorMax.Text.Meta" parent="SensorMax.Text.Value">
        <item name="android:textColor">@color/sm_text_label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Axis letter beside its spinner -->
    <style name="SensorMax.Text.Axis" parent="SensorMax.Text.Value">
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rows of the telemetry table (also used for the rows MainActivity adds at runtime) -->
    <style name="SensorMax.Text.RowLabel" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/sm_text_label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SensorMax.Text.RowValue" parent="SensorMax.Text.Value">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Result box under an action (mounting check, static check, bearing hint) -->
    <style name="SensorMax.Text.Result" parent="">
        <item name="android:background">@drawable/sm_bg_raised</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/sm_text_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Live status line in the header -->
    <style name="SensorMax.Text.Status" parent="">
        <item name="android:background">@drawable/sm_bg_raised</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/sm_text_info</item>
        <item name="android:textSize">14sp</item>
        <item name="android:typeface">monospace</item>
    </style>

    <!-- Severity banner; the wrapper in the layout rounds it -->
    <style name="SensorMax.Text.Banner" parent="">
        <item name="android:background">@color/sm_surface_banner</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/sm_text_warn</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SensorMax.Text.Chip" parent="">
        <item name="android:background">@drawable/sm_bg_pill_ok</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/sm_text_ok</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Collapsible-section header inside a card (code flips the arrow glyph in the text) -->
    <style name="SensorMax.Text.Toggle" parent="">
        <item name="android:background">@drawable/sm_bg_toggle</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/sm_text_body</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Header row of a collapsible card -->
    <style name="SensorMax.Text.Accordion" parent="SensorMax.Text.Toggle">
        <item name="android:background">@drawable/sm_bg_accordion</item>
        <item name="android:paddingStart">@dimen/sm_card_padding</item>
        <item name="android:paddingEnd">@dimen/sm_card_padding</item>
        <item name="android:textColor">@color/sm_text_label</item>
    </style>

    <!-- ===== Fields ===== -->

    <style name="SensorMax.Field" parent="">
        <item name="android:background">@drawable/sm_bg_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/sm_text_primary</item>
        <item name="android:textColorHint">@color/sm_text_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SensorMax.Field.Mono" parent="SensorMax.Field">
        <item name="android:typeface">monospace</item>
    </style>

    <style name="SensorMax.Spinner" parent="">
        <item name="android:background">@drawable/sm_bg_spinner</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">36dp</item>
    </style>

    <!-- Spinner rows (wired through the theme: android:spinnerItemStyle / spinnerDropDownItemStyle) -->
    <style name="SensorMax.SpinnerItem" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/sm_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SensorMax.SpinnerDropDownItem" parent="">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/sm_text_body</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SensorMax.SeekBar" parent="">
        <item name="android:progressTint">@color/sm_cyan</item>
        <item name="android:progressBackgroundTint">@color/sm_border_field</item>
        <item name="android:thumbTint">@color/sm_cyan</item>
    </style>

    <!-- ===== Buttons ===== -->
    <!-- Colour = meaning: green records, cyan is the main action of a card, slate is secondary.
         Insets are zero so the visible button is exactly as tall as its layout_height. -->

    <style name="SensorMax.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sm_text_on_action</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/sm_radius_inner</item>
    </style>

    <style name="SensorMax.Button.Record" parent="SensorMax.Button">
        <item name="android:backgroundTint">@color/sm_action_record</item>
        <item name="backgroundTint">@color/sm_action_record</item>
    </style>

    <style name="SensorMax.Button.Accent" parent="SensorMax.Button">
        <item name="android:backgroundTint">@color/sm_action_accent</item>
        <item name="backgroundTint">@color/sm_action_accent</item>
    </style>

    <style name="SensorMax.Button.Neutral" parent="SensorMax.Button">
        <item name="android:backgroundTint">@color/sm_action_neutral</item>
        <item name="backgroundTint">@color/sm_action_neutral</item>
    </style>

    <style name="SensorMax.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sm_text_body</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/sm_radius_inner</item>
        <item name="strokeColor">@color/sm_border_field</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <!-- Compact variants for secondary rows with short labels (dock row 1, add/delete label) -->
    <style name="SensorMax.Button.Accent.Compact" parent="SensorMax.Button.Accent">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SensorMax.Button.Outlined.Compact" parent="SensorMax.Button.Outlined">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
